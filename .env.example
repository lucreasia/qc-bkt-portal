# -------------------------------------------------------------
# Firebase Configuration (Production Environment Variables)
# กรุณาคัดลอกไฟล์นี้เป็น .env แล้วนำค่า Firebase Config มาใส่
# -------------------------------------------------------------

# Web API Key จาก Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# Auth Domain เช่น your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com

# Project ID เช่น your-project-id
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# Storage Bucket เช่น your-project-id.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app

# Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID

# App ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
